# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.png
.playwright-mcp/

# supabase CLI cache
supabase/.temp/
.claude/settings.local.json

# monthly stats (scripts/monthly-report.py), local only
/reports/

# clay stills for the play header
!public/clay/*.png

# Production brand artwork and native asset catalog must travel with a build.
!public/branding/*.png
!resources/icon.png
!resources/splash.png
!resources/branding/countrivo-icon-master.png
!resources/branding/countrivo-splash-globe.png
!resources/branding/logo.png
!ios/App/App/Assets.xcassets/AppIcon.appiconset/*.png
!ios/App/App/Assets.xcassets/Splash.imageset/Default*.png

# Local anonymous backend regression artifacts
/.check-anonymous/
/.check-render/

# Local App Store screenshots and Swift package tooling output.
/resources/app-store-current/
/ios/App/CapApp-SPM/Package.resolved
